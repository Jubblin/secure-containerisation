# Pin to a release tag + index digest. Bump from Docker Hub tags when upgrading.
FROM nousresearch/hermes-agent:v2026.9.24@sha256:fca358f12efd65bfaaca05884166f15c0e2788375ca30d77061ac1ebc96452b7

# hadolint ignore=DL3066
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
# hadolint ignore=DL3066
USER root
RUN curl -fsSL -o /tmp/bw-linux.zip https://github.com/bitwarden/clients/releases/download/cli-v2026.9.1/bw-linux-2026.9.1.zip \
    && unzip -o /tmp/bw-linux.zip -d /tmp/bw \
    && install -m 755 /tmp/bw/bw /usr/local/bin/bw

USER hermes
RUN curl -fsSL https://claude.ai/install.sh | bash
