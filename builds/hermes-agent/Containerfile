    && apt-get install -y --no-install-recommends unzip \
    && rm -rf /var/lib/apt/lists/*
# hadolint ignore=DL3066
USER hermes
RUN curl --proto '=https' -fsSL -o /tmp/bw-linux.zip https://github.com/bitwarden/clients/releases/download/cli-v2026.9.1/bw-linux-2026.9.1.zip \
    && unzip -o /tmp/bw-linux.zip \
    && rm /tmp/bw-linux.zip \
    && curl --proto '=https' -fsSL https://claude.ai/install.sh | bash
